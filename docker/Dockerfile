# Stage 1: Build
FROM rust:1.83-alpine AS builder

# Install build dependencies for native libs (openssl, etc)
RUN apk add --no-cache musl-dev openssl-dev openssl-libs-static pkgconfig

WORKDIR /app

# Copy manifests for dependency caching
COPY Cargo.toml Cargo.lock ./

# Create dummy src for dependency build
RUN mkdir src && \
    echo "fn main() {}" > src/main.rs && \
    mkdir -p src/bin && \
    echo "fn main() {}" > src/bin/init.rs

# Build dependencies only (cached layer)
RUN cargo build --release && rm -rf src

# Copy actual source
COPY src ./src
COPY migrations ./migrations

# Copy .sqlx for offline mode if it exists (generated by sqlx prepare)
# If .sqlx doesn't exist, SQLX_OFFLINE won't work - build will require DATABASE_URL
COPY .sqlx* ./.sqlx/

# Build with offline mode (sqlx prepared queries)
ENV SQLX_OFFLINE=true
RUN touch src/main.rs src/bin/init.rs && cargo build --release

# Stage 2: Runtime
FROM alpine:3.21

# Install runtime dependencies
RUN apk add --no-cache ca-certificates tzdata

# Create non-root user for security
RUN addgroup -g 1000 trading && \
    adduser -D -s /bin/sh -u 1000 -G trading trading

WORKDIR /app

# Copy binary from builder
COPY --from=builder /app/target/release/trading-bot /usr/local/bin/

# Copy migrations for potential runtime use
COPY --from=builder /app/migrations ./migrations

# Create config and logs directories
RUN mkdir -p /app/config /app/logs && \
    chown -R trading:trading /app

# Copy example config files (user provides real config via volume mount)
COPY config/*.example.yaml /app/config/

# Set ownership
RUN chown -R trading:trading /app

USER trading

# Environment defaults
ENV RUST_LOG=info
ENV APP__PAPER_TRADING__ENABLED=true

# Health check using CLI status command
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD trading-bot status --format json | grep -q '"running":true' || exit 1

# Expose port for future web dashboard integration
EXPOSE 8080

# Entry point - use exec form for proper signal handling
ENTRYPOINT ["trading-bot"]
CMD ["start", "--foreground"]

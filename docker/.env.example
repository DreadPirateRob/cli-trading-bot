# Docker Compose Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env to version control!

# Database Configuration
DB_PASSWORD=your_secure_password_here

# Binance.US API Credentials (leave empty for paper trading only)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Trading Mode (true = paper trading, false = live trading)
PAPER_MODE=true

# Logging Level (trace, debug, info, warn, error)
RUST_LOG=info

# Optional: Custom config directory (default: ./config)
# CONFIG_DIR=./config
